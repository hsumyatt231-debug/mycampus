# Copy to .env and adjust before running the API.
APP_HOST=0.0.0.0
APP_PORT=8001
APP_ENV=development
API_PREFIX=/api/v1

# SQLite only (as required). Relative path is resolved from this directory.
DATABASE_URL=sqlite:///./mycampus.db

# Replace with a long random value before any non-local deployment.
SECRET_KEY=change-this-to-a-long-random-secret
ACCESS_TOKEN_TTL_MINUTES=1440

# Comma-separated origins; "*" is acceptable only for local development.
CORS_ORIGINS=*

SQL_ECHO=false
